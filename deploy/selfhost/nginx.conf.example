# Replace YOUR-DOMAIN. Install TLS with certbot before opening account forms.
server {
    listen 80;
    server_name YOUR-DOMAIN;
    client_max_body_size 7m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        # App rate limits only trust this header because nginx overwrites it.
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header oai-authenticated-user-id "";
        proxy_set_header oai-authenticated-user-email "";
        proxy_buffering off;
    }
}
